# Copy this file to `.env.local` and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Dev server port (default: 5173 — alinhado ao proxy Laravel deste monorepo)
VITE_PORT=5173

# Porta do `vite preview` (default: 4173); mesmo proxy /api que em dev
# VITE_PREVIEW_PORT=4173

# Onde o Vite encaminha chamadas do browser para /api/* (Laravel)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Public base path for the build (default: ./)
# Use an absolute path like "/architectui/" when deploying to a subdirectory.
VITE_BASE=./

# Google Ads no Lead Master (Campanhas/Dashboard). Scraping (OSM + Places) não depende desta flag.
# VITE_FEATURE_GOOGLE=true

# Opcional: pré-preenche o campo "Para" no Lead Master → WhatsApp (só dígitos, com DDI).
# Defina em `.env.local` (não commitado) para não expor o número no repositório.
# VITE_WHATSAPP_DEFAULT_RECIPIENT=5511999999999
