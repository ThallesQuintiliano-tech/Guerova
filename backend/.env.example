APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Origem do frontend (Vite). Usado no redirect pós-OAuth Google Ads → /leadmaster/campanhas
# FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp/cloud-api
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_BRIDGE_SECRET=

# WhatsApp Web (QR Code) — serviço Node em whatsapp-bridge/
# WHATSAPP_WEB_BRIDGE_URL=http://127.0.0.1:3100
# WHATSAPP_WEB_BRIDGE_TIMEOUT=30

# Serasa Experian — Anti Fraud Scores
# Docs: https://developer.serasaexperian.com.br/api/anti-fraud-scores
# IAM (homolog): https://uat-api.serasaexperian.com.br/security/iam/v1/client-identities/login
# IAM (prod):   https://api.serasaexperian.com.br/security/iam/v1/client-identities/login
# SERASA_IAM_URL=https://uat-api.serasaexperian.com.br/security/iam/v1/client-identities/login
# Base do Scores (sem barra final). Ajuste conforme seu contrato/ambiente.
# Ex.: https://uat-api.serasaexperian.com.br/anti-fraud-scores/v1
# SERASA_SCORES_BASE_URL=
# SERASA_CLIENT_ID=
# SERASA_CLIENT_SECRET=
# Chave para descriptografar DOCUMENTCRYPTED da massa de testes (Python cryptocode; solicitar à Experian).
# SERASA_DOCUMENT_DECRYPT_KEY=
# true = resposta fictícia local (sem chamar Serasa); false = API real com credenciais acima (padrão no exemplo: mock)
SERASA_SCORE_USE_MOCK=true

# Google Ads API — OAuth + dados (https://developers.google.com/google-ads/api/docs/start)
# Pausar/ativar integração (padrão: false)
# GOOGLE_ADS_ENABLED=false
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# ID da conta de anúncios sem hífens (ex.: 1234567890)
# GOOGLE_ADS_CUSTOMER_ID=
# Conta MCC ao acessar contas filhas (opcional, sem hífens)
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_REDIRECT_URI=http://localhost:8000/api/google-ads/oauth/callback
# Após sucesso/erro o utilizador é enviado para FRONTEND_URL/leadmaster/campanhas?google_ads=ok|error
# rest (padrão, sem extensão grpc) ou grpc
# GOOGLE_ADS_TRANSPORT=rest

# Meta Ads (Facebook Marketing API via Graph API)
# true = ativa rotas /api/meta-ads/* e o painel em Configurações → Meta Ads
# META_ADS_ENABLED=false
# META_ADS_PREFER_ENV_TOKEN=true
# META_ADS_OAUTH_ENABLED=false
# Versão da Graph API (ex.: v21.0)
# META_GRAPH_VERSION=v21.0
#
# App (Definições → Básico da mesma app do Graph API Explorer). O App Secret não deve ir para o frontend.
# META_APP_ID=
# META_APP_SECRET=
# OAuth Facebook Login (Configurações → Conectar com Facebook)
# META_ADS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/facebook/callback
# META_ADS_OAUTH_SCOPES=email,public_profile,ads_read,ads_management
# Opcional: preencher só em .env local e rodar php artisan db:seed (conta slug default)
# META_ADS_ACCESS_TOKEN=
# META_ADS_AD_ACCOUNT_ID=act_1234567890
# META_ADS_DEFAULT_CAMPAIGN_NAME=My Quickstart Campaign
#
# SSL (Windows / PHP sem bundle de CA): erro cURL 60 "unable to get local issuer certificate"
# Afeta Meta Ads, scraping (Nominatim/Overpass/Google Places) e outras chamadas HTTP do backend.
# Opção recomendada: descarregue https://curl.se/ca/cacert.pem e aponte o caminho absoluto:
# META_ADS_HTTP_CAINFO=C:\caminho\para\cacert.pem
# Alternativa só para desenvolvimento local (nunca em produção):
# META_ADS_HTTP_VERIFY_SSL=false
#
# Scraping — Google Places (só se VITE_FEATURE_GOOGLE=true no frontend)
# GOOGLE_MAPS_API_KEY=
# SCRAPING_DEFAULT_CITY=São Paulo, Brasil
#
# O user access token da Meta cola-se no painel (Configurações); não coloque tokens no .env.example nem em git.

# Gemini — pacote de campanha a partir do briefing (Lead Master → Gerar campanha com IA)
# Chave: https://aistudio.google.com/apikey — nunca commitar a chave real
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-2.0-flash-lite
# GEMINI_TIMEOUT=60
# Se a API falhar, usa pacote local (true) ou devolve erro (false)
# GEMINI_FALLBACK_MOCK=true
